{
  "permissions": {
    "deny": [
      "WebFetch",
      "WebSearch"
    ],
    "allow": [
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_context",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_status"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONIOENCODING=utf-8 python scripts/hooks/large_file_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONIOENCODING=utf-8 python scripts/hooks/output_filter.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONIOENCODING=utf-8 python scripts/hooks/knowledge_sync.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "nexacro-claude-skills@nexacro-claude-skills": false,
    "nexacro-fullstack-starter@nexacro-claude-skills": false,
    "frontend-design@claude-plugins-official": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "context-engineering@context-engineering-marketplace": false,
    "glm-plan-usage@zai-coding-plugins": false,
    "document-skills@anthropic-agent-skills": false,
    "claude-hud@claude-hud": false,
    "superpowers@superpowers-dev": false,
    "claude-mem@thedotmack": false
  }
}
