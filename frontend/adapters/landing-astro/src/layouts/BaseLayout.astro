---
/**
 * BaseLayout.astro — Root HTML layout for all landing pages.
 * Imports global CSS (tokens + fonts + motion keyframes).
 * Injects motion observer island as a deferred script.
 */
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  siteSlug?: string
}

const { title, description, ogImage, siteSlug = '' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {title && <meta property="og:title" content={title} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />

    <!-- Motion observer island: IntersectionObserver for scroll-triggered animations.
         Deferred (type=module). Respects prefers-reduced-motion:
           - reduced-motion ON  => content shown immediately, no hiding, no observer.
           - reduced-motion OFF => elements hidden at init, revealed on intersection.
         No autoplay (WCAG 2.2.2). -->
    <script type="module">
      // Motion observer — lightweight IntersectionObserver island.
      // Targets elements with data-motion attribute.
      // prefers-reduced-motion: when active, we skip hiding entirely so content
      // is immediately visible (accessibility — no content ever lost).
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')

      function revealEl(el, observer) {
        const preset = el.dataset.motion
        // Always reveal the container first, regardless of preset.
        el.classList.remove('motion-hidden')

        if (preset === 'stagger-children') {
          // Stagger: animate each direct child with delay offset
          const staggerDelay = Number(el.dataset.staggerDelay ?? 80)
          Array.from(el.children).forEach((child, i) => {
            child.style.animationDelay = `${i * staggerDelay}ms`
            child.classList.remove('motion-hidden')
            child.classList.add('motion-stagger-child', 'motion-visible')
          })
        } else if (preset === 'fade-up' || preset === 'reveal-on-scroll') {
          el.classList.add('motion-fade-up')
        } else if (preset === 'scale-in') {
          el.classList.add('motion-scale-in')
        } else {
          // fade-simple fallback for unknown presets
          el.classList.add('motion-fade-simple')
        }

        if (observer) observer.unobserve(el)
      }

      function initMotion() {
        const targets = document.querySelectorAll('[data-motion]')
        if (!targets.length) return

        // Reduced-motion short-circuit: do not hide or observe anything.
        // Content stays visible immediately — no scroll-reveal behaviour.
        if (motionQuery.matches) return

        // Hide targets before observing so they can be revealed on scroll.
        targets.forEach((el) => el.classList.add('motion-hidden'))

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              revealEl(entry.target, observer)
            })
          },
          // threshold:0 fires as soon as any pixel enters viewport.
          // rootMargin top 200px pre-triggers elements just below fold.
          // No negative bottom margin — avoids hiding sections in full-page
          // screenshot contexts (headless, Playwright fullPage:true).
          { threshold: 0, rootMargin: '200px 0px 200px 0px' }
        )

        targets.forEach((el) => observer.observe(el))

        // Safety fallback: reveal all remaining hidden elements after 800ms
        // in case IntersectionObserver never fires (e.g. hidden iframe, print).
        setTimeout(() => {
          document.querySelectorAll('[data-motion].motion-hidden').forEach((el) => {
            revealEl(el, null)
          })
        }, 800)
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMotion)
      } else {
        initMotion()
      }
    </script>
  </body>
</html>
