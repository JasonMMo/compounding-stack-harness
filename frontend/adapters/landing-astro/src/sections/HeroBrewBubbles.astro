---
/**
 * HeroBrewBubbles.astro — Hero Banner section, variant: brew.
 * Harvest-theme warm-organic hero. No JS canvas. Texture via:
 *   1. Gradient amber-to-deep-malt background (CSS, theme tokens).
 *   2. Inline SVG feTurbulence grain/noise overlay (aria-hidden, 3% opacity).
 *   3. Rising effervescence bubbles — CSS @keyframes bubble-rise (global.css).
 *      Reduced-motion: bubbles rendered static (animation: none via media query).
 *   4. Soft radial glow at top-center (~15% opacity) — restrained, not glowy canvas.
 *
 * No-JS visibility: h1 and CTA are plain HTML, opacity:1 by default.
 * No framer-motion, no client:* directive. Pure SSR Astro.
 *
 * Invariants:
 *   - Content (h1, p, a) is NEVER set to opacity:0 in SSR markup.
 *   - Bubble divs are aria-hidden and purely decorative.
 *   - Grain SVG is aria-hidden.
 *   - G-8: ASCII filename.
 */

interface Props {
  copy: Record<string, string>
  cta?: { label: string; href: string }
  motionPreset?: string
}

const { copy = {}, cta } = Astro.props
---

<section
  class="relative w-full overflow-hidden"
  style="
    background: linear-gradient(
      160deg,
      var(--color-hero-bg-from, #C97C30) 0%,
      var(--color-hero-bg-to, #7A4110) 100%
    );
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding: var(--space-section-y, 104px) var(--space-container-gutter, 24px);
  "
  data-motion="fade-up"
>
  <!-- Soft radial glow: top-center warm highlight, restrained (~12% opacity) -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      top: -10%;
      left: 50%;
      transform: translateX(-50%);
      width: 70%;
      height: 60%;
      background: radial-gradient(ellipse at center, rgba(255,220,140,0.18) 0%, transparent 70%);
      pointer-events: none;
    "
  ></div>

  <!-- Grain / noise texture overlay: inline SVG feTurbulence, aria-hidden -->
  <!-- opacity 0.035 = perceptible tactile texture without colour distortion -->
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;opacity:0.035;"
  >
    <filter id="brew-grain">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.72"
        numOctaves="4"
        stitchTiles="stitch"
      />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#brew-grain)" />
  </svg>

  <!-- Rising effervescence bubbles: CSS-only, aria-hidden -->
  <!-- 9 bubbles, staggered delays + sizes for organic feel -->
  <div aria-hidden="true" style="position:absolute;inset:0;overflow:hidden;pointer-events:none;">
    <div class="bubble" style="width:6px;height:6px;left:12%;bottom:5%;--bubble-duration:8.2s;--bubble-delay:0s;"></div>
    <div class="bubble" style="width:9px;height:9px;left:24%;bottom:8%;--bubble-duration:9.8s;--bubble-delay:1.1s;"></div>
    <div class="bubble" style="width:5px;height:5px;left:38%;bottom:3%;--bubble-duration:7.6s;--bubble-delay:2.4s;"></div>
    <div class="bubble" style="width:11px;height:11px;left:51%;bottom:10%;--bubble-duration:10.4s;--bubble-delay:0.7s;"></div>
    <div class="bubble" style="width:7px;height:7px;left:63%;bottom:6%;--bubble-duration:8.9s;--bubble-delay:3.2s;"></div>
    <div class="bubble" style="width:4px;height:4px;left:74%;bottom:2%;--bubble-duration:7.1s;--bubble-delay:1.8s;"></div>
    <div class="bubble" style="width:8px;height:8px;left:82%;bottom:9%;--bubble-duration:9.3s;--bubble-delay:0.3s;"></div>
    <div class="bubble" style="width:6px;height:6px;left:91%;bottom:4%;--bubble-duration:8.5s;--bubble-delay:2.9s;"></div>
    <div class="bubble" style="width:10px;height:10px;left:44%;bottom:15%;--bubble-duration:11.0s;--bubble-delay:4.1s;"></div>
  </div>

  <!-- Content: always opacity:1 in SSR. No motion-hidden class on the text block. -->
  <div
    class="relative z-10 max-w-[var(--space-container-max,1180px)] mx-auto text-center w-full"
  >
    {copy.headline && (
      <h1
        style="
          font-family: var(--font-family-display, sans-serif);
          font-size: clamp(56px, 10vw, 120px);
          font-weight: var(--font-weight-display, 900);
          letter-spacing: var(--font-letter-spacing-display, -0.02em);
          line-height: 0.95;
          color: var(--color-surface-1, #F8F5F0);
          margin: 0 0 0.5em;
          text-transform: uppercase;
          opacity: 1;
        "
      >
        {copy.headline}
      </h1>
    )}

    {copy.subhead && (
      <p
        style="
          font-family: var(--font-family-body, sans-serif);
          font-size: clamp(17px, 2.2vw, 22px);
          line-height: 1.6;
          color: var(--color-surface-1, #F8F5F0);
          opacity: 0.88;
          max-width: 600px;
          margin: 0 auto 2.5rem;
        "
      >
        {copy.subhead}
      </p>
    )}

    {cta && (
      <a
        href={cta.href}
        style="
          display: inline-block;
          padding: 0.85rem 2.5rem;
          border-radius: var(--radius-button, 6px);
          background: var(--color-surface-1, #F8F5F0);
          color: var(--color-primary, #9C5118);
          font-family: var(--font-family-display, sans-serif);
          font-weight: 800;
          font-size: 1rem;
          text-transform: uppercase;
          letter-spacing: 0.06em;
          text-decoration: none;
          transition: background 180ms ease, color 180ms ease;
          opacity: 1;
        "
        onmouseover="this.style.background='var(--color-primary-subtle, #F5EDD8)'"
        onmouseout="this.style.background='var(--color-surface-1, #F8F5F0)'"
      >
        {cta.label}
      </a>
    )}

    <!-- Foam highlight accent line below CTA -->
    <div
      aria-hidden="true"
      style="
        width: 48px;
        height: 3px;
        border-radius: 9999px;
        background: var(--color-foam-highlight, #BBEBC8);
        margin: 2.5rem auto 0;
        opacity: 0.7;
      "
    ></div>
  </div>
</section>
