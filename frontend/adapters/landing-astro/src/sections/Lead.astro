---
/**
 * Lead.astro — Lead capture section (type: lead).
 * Variants: minimal-field | multi-field-card (stub)
 *
 * minimal-field: centered single email input + submit button.
 *   Copy slots: headline, subhead, button_label, placeholder, success_message.
 *   DEC-5 / G-1: submits via entity.create(entity_type=lead) — REUSES the
 *   same wire key path as ContactForm.astro. No new contract key.
 *   DEMO_MODE: shows success_message without a network call.
 *
 * All colors via theme tokens — no hardcoded hex (theme-tokenized invariant).
 * Fully visible without JS (Growth-69): form renders in SSR at opacity:1.
 */

interface Props {
  copy: Record<string, string>
  variant?: string
  styleHints?: Record<string, string>
  motionPreset?: string
}

const {
  copy = {},
  variant = 'minimal-field',
  motionPreset = 'fade-simple',
} = Astro.props

const apiBase = import.meta.env.PUBLIC_API_BASE ?? ''
const rawDemoMode = import.meta.env.PUBLIC_DEMO_MODE ?? ''
const isDemoMode = rawDemoMode === '1' || rawDemoMode.toLowerCase() === 'true'

// entity.create path (same as ContactForm.astro, no reimplementation)
const endpointPath = `/api/entities/lead`
const actionUrl = apiBase ? `${apiBase.replace(/\/$/, '')}${endpointPath}` : endpointPath

const headline = copy.headline ?? ''
const subhead = copy.subhead ?? ''
const buttonLabel = copy.button_label ?? 'Subscribe'
const placeholder = copy.placeholder ?? 'your@email.com'
const successMessage = copy.success_message ?? "You're on the list."

// Unique form id for scoped JS
const formId = 'lead-capture-form'
---

<section
  id="lead"
  class="w-full py-[var(--space-section-y,104px)] px-[var(--space-container-gutter,24px)]"
  style="background: var(--color-section-alt-bg, var(--color-surface-2, #B08556));"
  data-motion={motionPreset}
>
  <div
    class="mx-auto text-center"
    style="max-width: 560px;"
  >
    {headline && (
      <h2
        class="text-3xl md:text-4xl mb-4"
        style="
          font-family: var(--font-family-display, serif);
          font-weight: var(--font-weight-display, 700);
          letter-spacing: var(--font-letter-spacing-display, -0.02em);
          color: var(--color-text-1, #1E140A);
        "
      >
        {headline}
      </h2>
    )}
    {subhead && (
      <p
        class="text-base md:text-lg mb-10 leading-relaxed"
        style="color: var(--color-text-2, #4A3020); font-family: var(--font-family-body, serif);"
      >
        {subhead}
      </p>
    )}

    {variant === 'minimal-field' && (
      <!-- Progressive enhancement: renders as plain HTML form in SSR.
           JS adds DEMO_MODE short-circuit and JSON submit on top. -->
      <form
        id={formId}
        data-action={actionUrl}
        data-demo={isDemoMode ? 'true' : undefined}
        data-success={successMessage}
        class="flex flex-col sm:flex-row gap-3 justify-center items-stretch"
        novalidate
        aria-label={headline || 'Email signup'}
      >
        <label for="lead-email" class="sr-only">Email address</label>
        <input
          id="lead-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={placeholder}
          class="flex-1 px-4 py-3 text-base"
          style="
            border: 1px solid var(--color-surface-3, #8C6438);
            border-radius: var(--radius-button, 4px);
            background: var(--color-surface-1, #C9A078);
            color: var(--color-text-1, #1E140A);
            font-family: var(--font-family-body, serif);
            min-width: 0;
          "
          aria-required="true"
        />
        <button
          type="submit"
          class="px-6 py-3 text-sm font-semibold uppercase tracking-[0.1em] whitespace-nowrap transition-colors"
          style="
            background: var(--color-primary, #B5501A);
            color: #ffffff;
            border-radius: var(--radius-button, 4px);
            border: none;
            cursor: pointer;
            font-family: var(--font-family-body, serif);
          "
        >
          {buttonLabel}
        </button>
      </form>
    )}

    {variant !== 'minimal-field' && (
      <!-- multi-field-card: future variant — render stub label for now -->
      <p style="color: var(--color-text-3, #3D2510); font-style: italic;">
        Contact form ({variant})
      </p>
    )}

    <!-- Status message: hidden by default; JS shows on submit -->
    <div
      id="lead-status"
      role="status"
      aria-live="polite"
      class="mt-4 text-sm hidden"
      style="color: var(--color-text-1, #1E140A);"
    />
  </div>
</section>

<script>
  // Lead form JS enhancement (minimal-field variant).
  // DEC-5 / G-1: wire_key = entity.create, entity_type = lead.
  // Progressive enhancement: form submits via JSON POST; DEMO_MODE short-circuits.
  (function () {
    const form = document.getElementById('lead-capture-form') as HTMLFormElement | null
    const statusEl = document.getElementById('lead-status') as HTMLElement | null
    if (!form || !statusEl) return

    const action = form.dataset.action ?? ''
    const successMessage = form.dataset.success ?? "You're on the list."

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      if (btn) btn.disabled = true

      statusEl.classList.remove('hidden')
      statusEl.textContent = 'Sending…'
      statusEl.style.color = 'var(--color-text-2, #4A3020)'

      // DEMO MODE: short-circuit — no network call.
      if (form.dataset.demo === 'true') {
        statusEl.textContent = successMessage
        statusEl.style.color = 'var(--color-text-1, #1E140A)'
        form.reset()
        if (btn) btn.disabled = false
        return
      }

      const emailInput = form.querySelector('#lead-email') as HTMLInputElement | null
      const email = emailInput?.value.trim() ?? ''

      // entity.create request shape per wire-v1.yaml
      const body = {
        entity_type: 'lead',
        data: { email },
      }

      try {
        const res = await fetch(action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        })
        const json = await res.json().catch(() => ({}))

        if (res.ok && !json.error) {
          statusEl.textContent = successMessage
          statusEl.style.color = 'var(--color-text-1, #1E140A)'
          form.reset()
        } else {
          const msg = json.error?.message ?? `Error ${res.status}`
          statusEl.textContent = `Failed: ${msg}`
          statusEl.style.color = 'var(--color-primary, #B5501A)'
          if (btn) btn.disabled = false
        }
      } catch {
        statusEl.textContent = 'Network error — please try again.'
        statusEl.style.color = 'var(--color-primary, #B5501A)'
        if (btn) btn.disabled = false
      }
    })
  })()
</script>
