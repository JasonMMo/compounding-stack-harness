---
/**
 * HeroHeadlineOnly.astro — Typographic hero (hero/headline-only variant).
 * Type IS the design. No background imagery, no stat row, no decorative canvas.
 * One massive display headline, one subhead line, one CTA. Asymmetric layout:
 * headline bleeds wide, CTA sits beneath with deliberate horizontal offset.
 *
 * invariants:
 *   - No hardcoded hex — all colors via theme tokens (--color-*)
 *   - No opacity:0 in SSR output — content visible without JS (Growth-69 rule)
 *   - data-motion drives entrance animation from BaseLayout observer island
 *   - WCAG AA contrast maintained (checked per atelier theme a11y block)
 */
interface Props {
  copy: Record<string, string>
  cta?: { label: string; href: string }
  styleHints?: Record<string, string>
  motionPreset?: string
}

const {
  copy = {},
  cta,
  styleHints = {},
  motionPreset = 'fade-up',
} = Astro.props

const bg = styleHints.bg ?? 'dark'
const ctaStyle = styleHints.cta_style ?? 'primary-outline'

// BG: dark = ink-black hero surface via hero-bg-from token
const bgClass = bg === 'dark'
  ? 'bg-[var(--color-hero-bg-from,#141418)]'
  : bg === 'gradient'
    ? 'bg-gradient-to-br from-[var(--color-hero-bg-from,#141418)] to-[var(--color-hero-bg-to,#201F27)]'
    : 'bg-[var(--color-surface-1,#F5F2EC)]'

const onDark = bg === 'dark' || bg === 'gradient'
const headlineColor = onDark ? 'text-[var(--color-surface-1,#F5F2EC)]' : 'text-[var(--color-text-1,#201F27)]'
const subheadColor = onDark ? 'text-[var(--color-surface-2,#E8E2D8)] opacity-75' : 'text-[var(--color-text-2,#4A4957)]'

const ctaClass: Record<string, string> = {
  'primary-outline': 'inline-block px-8 py-3 border border-[var(--color-surface-2,#E8E2D8)] text-[var(--color-surface-1,#F5F2EC)] font-semibold text-base tracking-wide uppercase hover:bg-[var(--color-surface-1,#F5F2EC)] hover:text-[var(--color-hero-bg-from,#141418)] transition-colors',
  'inverse-lg': 'inline-block px-8 py-3 bg-[var(--color-surface-1,#F5F2EC)] text-[var(--color-hero-bg-from,#141418)] font-semibold text-lg hover:bg-[var(--color-surface-2,#E8E2D8)] transition-colors',
  'primary-lg': 'inline-block px-8 py-3 bg-[var(--color-primary,#9A5B32)] text-[var(--color-surface-1,#F5F2EC)] font-semibold text-lg hover:bg-[var(--color-primary-hover,#B56D3F)] transition-colors',
}
---

<section
  class={`relative w-full min-h-[85vh] flex items-end pb-[var(--space-section-y,120px)] px-[var(--space-container-gutter,24px)] ${bgClass}`}
  data-motion={motionPreset}
  aria-label="Site introduction"
>
  <div class="max-w-[var(--space-container-max,1120px)] mx-auto w-full">
    <!-- Vertical rhythm: eyebrow label (optional kicker — used at most once, not repeated) -->
    {copy.eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-primary,#9A5B32)] mb-8">
        {copy.eyebrow}
      </p>
    )}

    <!-- Display headline: left-aligned, 7xl on desktop, fluid down.
         font-family via theme token. letter-spacing via token.
         Deliberate: no centered layout — asymmetry IS the voice. -->
    {copy.headline && (
      <h1
        class={`text-5xl md:text-6xl lg:text-[length:var(--font-size-7xl,88px)] font-[var(--font-weight-display,800)] leading-[1.02] tracking-[var(--font-letter-spacing-display,-0.03em)] mb-8 max-w-5xl ${headlineColor}`}
        style="font-family: var(--font-family-display, inherit);"
      >
        {copy.headline}
      </h1>
    )}

    <!-- Subhead: narrower column, deliberately stepped back from the headline -->
    {copy.subhead && (
      <p class={`text-lg md:text-xl mb-10 max-w-xl ${subheadColor}`}>
        {copy.subhead}
      </p>
    )}

    <!-- CTA row: left-aligned, honest size — does not compete with the headline -->
    {cta && (
      <a
        href={cta.href}
        class={ctaClass[ctaStyle] ?? ctaClass['primary-outline']}
        style="border-radius: var(--radius-button, 2px);"
      >
        {cta.label}
      </a>
    )}
  </div>
</section>
