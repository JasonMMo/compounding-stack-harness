---
/**
 * Cta.astro — Call-to-Action Band section (type: cta).
 * Variants: centered | left-aligned | with-image | newsletter-inline
 * Style hints: bg (primary|dark|light|gradient), text_align, cta_style, media_position
 *
 * newsletter-inline (NEW — A3 Event archetype):
 *   Dark band (#161210 via hero-bg-from), centered, max-width 600px container.
 *   Email input inline with crimson submit button on desktop.
 *   Stack (input full-width + button full-width) on mobile (<640px).
 *   WCAG: <label for="newsletter-email"> required (sr-only or visible).
 *   DEMO_MODE: PUBLIC_DEMO_MODE === '1'|'true' → JS prevents POST; shows stub msg.
 *   Growth-69 invariant: full content visible without JS (form renders SSR).
 */
interface StyleHints {
  bg?: string
  text_align?: string
  cta_style?: string
  media_position?: string
}

interface Props {
  copy: Record<string, string>
  assets?: string[]
  cta?: { label: string; href: string }
  variant?: string
  styleHints?: StyleHints
  motionPreset?: string
}

const {
  copy = {},
  assets = [],
  cta,
  variant = 'centered',
  styleHints = {},
  motionPreset = 'scale-in',
} = Astro.props

// DEMO_MODE (newsletter-inline)
const rawDemoMode = import.meta.env.PUBLIC_DEMO_MODE ?? ''
const isDemoMode = rawDemoMode === '1' || rawDemoMode.toLowerCase() === 'true'

const bg = styleHints.bg ?? 'primary'
const textAlign = styleHints.text_align ?? 'center'
const ctaStyle = styleHints.cta_style ?? 'inverse-lg'

const bgClass: Record<string, string> = {
  primary: 'bg-[var(--color-primary,#6D28D9)]',
  gradient: 'bg-gradient-to-r from-[var(--color-hero-bg-from,#1E1B4B)] to-[var(--color-hero-bg-to,#4C1D95)]',
  dark: 'bg-[var(--color-text-1,#111827)]',
  light: 'bg-[var(--color-surface-2,#F9FAFB)]',
}

const textColor = (bg === 'primary' || bg === 'gradient' || bg === 'dark') ? 'text-white' : 'text-[var(--color-text-1,#111827)]'

const ctaClass: Record<string, string> = {
  'inverse-lg': 'inline-block px-8 py-3 rounded-[var(--radius-button,8px)] bg-white text-[var(--color-primary,#6D28D9)] font-bold text-lg hover:bg-[var(--color-primary-subtle,#F5F3FF)] transition-colors',
  'primary-lg': 'inline-block px-8 py-3 rounded-[var(--radius-button,8px)] bg-[var(--color-primary,#6D28D9)] text-white font-bold text-lg hover:bg-[var(--color-primary-hover,#5B21B6)] transition-colors',
  'primary-outline': 'inline-block px-8 py-3 rounded-[var(--radius-button,8px)] border-2 border-white text-white font-bold text-lg hover:bg-white/10 transition-colors',
  'ghost': 'inline-block px-8 py-3 text-white font-bold text-lg underline hover:no-underline',
}

const isSplit = variant === 'with-image'
---

{variant === 'newsletter-inline' ? (
  /*
   * newsletter-inline: dark band, centered, max-width 600px.
   * Email input + crimson submit inline (desktop); stacked (mobile).
   * Sub-copy color: rgba(250,250,248,0.72) — CDO-specified fallback on dark bg
   *   (text-3 #7D6E6A on #161210 ≈ 4.2:1; surface-3 at opacity 0.72 ensures AA).
   * Growth-69: form renders in SSR at full opacity — no JS blank.
   */
  <section
    data-motion={motionPreset}
    style={`background:var(--color-hero-bg-from,#161210);padding:var(--space-section-y,88px) var(--space-container-gutter,20px);`}
  >
    <div style="max-width:600px;margin:0 auto;text-align:center;">
      {copy.headline && (
        <h2 style="font-family:var(--font-family-display,inherit);font-size:var(--font-size-5xl,48px);font-weight:var(--font-weight-display,800);color:var(--color-surface-1,#FAFAF8);margin:0 0 16px;letter-spacing:var(--font-letter-spacing-display,-0.01em);">
          {copy.headline}
        </h2>
      )}
      {copy.sub_copy && (
        <p style="font-family:var(--font-family-body,inherit);font-size:17px;line-height:1.6;color:rgba(250,250,248,0.72);margin:0 0 32px;">
          {copy.sub_copy}
        </p>
      )}

      {/* Accessible label (sr-only) — WCAG 1.3.1 */}
      <form
        id="newsletter-form"
        action="#"
        method="post"
        novalidate
        data-demo={isDemoMode ? 'true' : undefined}
        data-success={copy.demo_stub_message ?? '[DEMO] You\'re on the list. This connects to your email platform in production.'}
        aria-label={copy.headline ?? 'Newsletter signup'}
        class="cta-newsletter-form"
      >
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={copy.placeholder ?? 'your@email.com'}
          style="flex:1;height:48px;border-radius:var(--radius-button,8px);background:var(--color-surface-1,#FAFAF8);color:var(--color-text-1,#1E1A18);border:1.5px solid var(--color-surface-3,#E5E2DC);font-family:var(--font-family-body,inherit);font-size:16px;padding:0 16px;min-width:0;"
          aria-required="true"
        />
        <button
          type="submit"
          style="height:48px;background:var(--color-primary,#C41E22);color:var(--color-surface-1,#FAFAF8);border-radius:var(--radius-button,8px);border:none;cursor:pointer;font-family:var(--font-family-display,inherit);font-weight:700;font-size:15px;padding:0 28px;white-space:nowrap;transition:background 150ms ease;"
          onmouseover="this.style.background='var(--color-primary-hover,#D9262B)'"
          onmouseout="this.style.background='var(--color-primary,#C41E22)'"
          onmousedown="this.style.background='var(--color-primary-active,#A91820)'"
          onmouseup="this.style.background='var(--color-primary-hover,#D9262B)'"
        >
          {copy.button_label ?? 'Join the Waitlist'}
        </button>
      </form>

      {/* Demo stub — JS reveals this on submit in DEMO_MODE */}
      <p
        id="newsletter-demo-msg"
        hidden
        style="color:var(--color-primary,#C41E22);font-size:14px;margin-top:8px;font-family:var(--font-family-body,inherit);"
      >
        {copy.demo_stub_message ?? '[DEMO] You\'re on the list. This connects to your email platform in production.'}
      </p>

      {copy.legal_copy && (
        <p style="font-family:var(--font-family-body,inherit);font-size:13px;color:rgba(250,250,248,0.50);margin-top:16px;">
          {copy.legal_copy}
        </p>
      )}
    </div>
  </section>

  <script>
    // newsletter-inline DEMO_MODE handler.
    // Prevents form POST in demo; reveals demo stub message.
    // Progressive enhancement: form is visible and usable without JS (action="#" is inert).
    (function () {
      const form = document.getElementById('newsletter-form') as HTMLFormElement | null
      const demoMsg = document.getElementById('newsletter-demo-msg') as HTMLElement | null
      if (!form) return

      form.addEventListener('submit', (e) => {
        e.preventDefault()
        if (form.dataset.demo === 'true' && demoMsg) {
          demoMsg.hidden = false
          form.style.display = 'none'
        }
        // Production: wire to endpoint via fetch (integration point).
      })
    })()
  </script>
) : (
  <section
    class={`w-full py-[var(--space-section-y,112px)] px-[var(--space-container-gutter,24px)] ${bgClass[bg] ?? bgClass.primary} ${textColor}`}
    data-motion={motionPreset}
  >
    <div class={`max-w-[var(--space-container-max,1200px)] mx-auto ${isSplit ? 'grid grid-cols-1 md:grid-cols-2 gap-12 items-center' : 'text-center'}`}>
      <div class={textAlign === 'left' ? 'text-left' : 'text-center'}>
        {copy.headline && (
          <h2 class="text-3xl md:text-4xl font-bold mb-4" style="font-family: var(--font-family-display, inherit);">
            {copy.headline}
          </h2>
        )}
        {copy.subhead && (
          <p class="text-lg opacity-80 mb-8 max-w-xl">
            {copy.subhead}
          </p>
        )}
        {cta && (
          <a href={cta.href} class={ctaClass[ctaStyle] ?? ctaClass['inverse-lg']}>
            {cta.label}
          </a>
        )}
      </div>

      {isSplit && assets.length > 0 && (
        <div>
          <img
            src={assets[0]}
            alt=""
            class="w-full rounded-[var(--radius-card,16px)]"
            loading="lazy"
          />
        </div>
      )}
    </div>
  </section>
)}
