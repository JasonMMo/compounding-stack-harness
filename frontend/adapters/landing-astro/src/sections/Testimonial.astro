---
/**
 * Testimonial.astro — Testimonial / Social Proof section (type: testimonial).
 * Variants: single-card | carousel | grid | pull-quote-wall
 * Style hints: layout, quote_style (large|normal), avatar (circle|square|none)
 * No autoplay (WCAG 2.2.2 — a11y invariant).
 *
 * pull-quote-wall: full-bleed asymmetric grid of 2-3 large pull-quotes (CDO spec 2026-06-16).
 *   Typographic — no card boxing. Avatar: none by default.
 *   Primary quote (items[0]): larger col, larger type (display family).
 *   Secondary quotes: smaller col, subordinate type.
 *   items[] required for multi-quote; falls back to copy.quote for single.
 *   No JS required. Growth-69 invariant: all content visible without JS.
 */
interface StyleHints {
  layout?: string
  quote_style?: string
  avatar?: string
  autoplay?: boolean
}

interface QuoteItem {
  quote: string
  author_name: string
  author_title?: string
  company?: string
  author_photo?: string
  avatar?: string
}

interface Props {
  copy: Record<string, string>
  assets?: string[]
  variant?: string
  styleHints?: StyleHints
  motionPreset?: string
  items?: QuoteItem[]
}

const {
  copy = {},
  assets = [],
  variant = 'single-card',
  styleHints = {},
  motionPreset = 'stagger-children',
  items = [],
} = Astro.props

const quoteStyle = styleHints.quote_style ?? 'normal'
const avatarShape = styleHints.avatar ?? 'circle'
// autoplay: never (WCAG 2.2.2 invariant — even if theme sets it true, we ignore)
const avatarClass: Record<string, string> = {
  circle: 'w-12 h-12 rounded-full object-cover',
  square: 'w-12 h-12 rounded-[var(--radius-card,4px)] object-cover',
  none: 'hidden',
}

const quoteClass = quoteStyle === 'large'
  ? 'text-2xl md:text-3xl font-medium text-[var(--color-text-1,#111827)] italic leading-snug mb-6'
  : 'text-lg text-[var(--color-text-2,#374151)] italic mb-6'
---

<section
  class="w-full py-[var(--space-section-y,112px)] px-[var(--space-container-gutter,24px)] bg-[var(--color-surface-1,#fff)]"
  data-motion={motionPreset}
  data-stagger-delay="80"
>
  <div class="max-w-[var(--space-container-max,1200px)] mx-auto">

    {variant === 'pull-quote-wall' && (() => {
      /* Build quote list: prefer items[], fall back to single copy.quote */
      const quotes: QuoteItem[] = items.length > 0
        ? items
        : copy.quote
          ? [{ quote: copy.quote, author_name: copy.author_name ?? '', author_title: copy.author_title, company: copy.company }]
          : []
      const isPrimary = (i: number) => i === 0
      /*
       * Mobile-first grid:
       *   <768px  → single column (grid-cols-1), all quotes stack vertically.
       *   ≥768px  → asymmetric columns via inline style on the md-breakpoint wrapper.
       *   Tailwind alone cannot express `5fr 4fr 3fr` — we use a CSS custom property
       *   set via a wrapper class trick: md:grid wrapper switches from 1-col to multi-col
       *   using a data-attribute style injected only at md+ via a <style> block.
       *   Simpler: keep grid-cols-1 always via Tailwind, then override at md with a
       *   scoped class. We use the `[&]:md:` pattern via a sentinel class.
       *
       * Strategy: outer div is always grid-cols-1 on mobile. At md+ we apply the
       * multi-column grid via a dedicated CSS class in a <style> tag (scoped to this
       * component), not an inline style — so media queries work correctly.
       */
      const colClass = quotes.length >= 3 ? 'pqw-three' : 'pqw-two'
      return (
        <>
          <style>{`
            @media (min-width: 768px) {
              .pqw-two  { grid-template-columns: 7fr 5fr; }
              .pqw-three { grid-template-columns: 5fr 4fr 3fr; }
            }
          `}</style>
          <div class={`grid grid-cols-1 items-start gap-10 md:gap-[clamp(32px,5vw,64px)] ${colClass}`}>
            {quotes.map((q, i) => (
              <div class={isPrimary(i) ? 'pull-quote-primary' : 'pull-quote-secondary'}>
                {/* Opening quote mark — color: primary for primary, primary-border for secondary */}
                <span
                  class="block leading-none mb-2 select-none"
                  aria-hidden="true"
                  style={`font-size: ${isPrimary(i) ? '3.5rem' : '2.25rem'}; color: ${isPrimary(i) ? 'var(--color-primary)' : 'var(--color-primary-border)'};`}
                >{'”'}</span>
                <blockquote
                  style={`font-family: var(--font-family-display, inherit); font-size: clamp(${isPrimary(i) ? '1.25rem, 2.5vw, 2rem' : '1rem, 1.8vw, 1.5rem'}); font-weight: ${isPrimary(i) ? '600' : '500'}; line-height: 1.3; color: var(${isPrimary(i) ? '--color-text-1' : '--color-text-2'});`}
                >
                  {q.quote}
                </blockquote>
                <p
                  class="mt-5 text-sm font-medium tracking-[0.02em] text-[var(--color-text-3)]"
                  style="font-family: var(--font-family-body, inherit);"
                >
                  {'— '}{[q.author_name, q.author_title, q.company].filter(Boolean).join(', ')}
                </p>
              </div>
            ))}
          </div>
        </>
      )
    })()}

    {(variant === 'single-card' || variant === 'carousel') && copy.quote && (
      <div class="max-w-3xl mx-auto text-center">
        <svg class="w-8 h-8 text-[var(--color-primary,#6D28D9)] mx-auto mb-6 opacity-40" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>
        <blockquote class={quoteClass}>
          {copy.quote}
        </blockquote>
        <div class="flex items-center justify-center gap-3">
          {assets.length > 0 && avatarShape !== 'none' && (
            <img
              src={assets[0]}
              alt={copy.author_name ?? 'Author'}
              class={avatarClass[avatarShape] ?? avatarClass.circle}
              loading="lazy"
            />
          )}
          <div class="text-left">
            {copy.author_name && (
              <p class="font-semibold text-[var(--color-text-1,#111827)]">{copy.author_name}</p>
            )}
            {(copy.author_title || copy.company) && (
              <p class="text-sm text-[var(--color-text-3,#6B7280)]">
                {[copy.author_title, copy.company].filter(Boolean).join(', ')}
              </p>
            )}
          </div>
        </div>
      </div>
    )}

    {variant === 'grid' && (() => {
      /* Build card list: prefer items[], fall back to single copy.quote card */
      const gridItems: QuoteItem[] = items.length > 0
        ? items
        : copy.quote
          ? [{ quote: copy.quote, author_name: copy.author_name ?? '', author_title: copy.author_title, company: copy.company }]
          : []
      return (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" role="list">
          {gridItems.map((item) => (
            /* One card per item. Avatar: initials-circle when item.avatar present (no photo assets).
               Theme-tokenized: primary-subtle bg, primary text for initials.
               No hardcoded hex. No JS. a11y: quote in <blockquote>, author visible. */
            <div
              class="p-6 rounded-[var(--radius-card,16px)] border border-[var(--color-border,#E5E7EB)] bg-[var(--color-surface-1,#fff)] flex flex-col"
              role="listitem"
            >
              <blockquote class="text-[var(--color-text-2,#374151)] italic mb-4 flex-1">
                {item.quote}
              </blockquote>
              <div class="flex items-center gap-3">
                {item.avatar ? (
                  /* Initials-circle avatar — no fabricated photo */
                  <div
                    class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold select-none"
                    style="background: var(--color-primary-subtle, #EDE9FE); color: var(--color-primary, #6D28D9);"
                    aria-hidden="true"
                  >
                    {item.avatar}
                  </div>
                ) : (assets.length > 0 && avatarShape !== 'none') ? (
                  <img
                    src={assets[0]}
                    alt={item.author_name ?? 'Author'}
                    class={avatarClass[avatarShape] ?? avatarClass.circle}
                    loading="lazy"
                  />
                ) : null}
                <div>
                  {item.author_name && (
                    <p class="text-sm font-semibold text-[var(--color-text-1,#111827)]">{item.author_name}</p>
                  )}
                  {(item.author_title || item.company) && (
                    <p class="text-xs text-[var(--color-text-3,#6B7280)]">
                      {[item.author_title, item.company].filter(Boolean).join(', ')}
                    </p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      )
    })()}
  </div>
</section>
