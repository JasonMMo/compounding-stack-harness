---
/**
 * HeroBentoGrid.astro -- Hero Banner section, variant: bento-grid.
 * A7 archetype: API Platform / Developer Tool.
 *
 * Layout: 7-col text left / 5-col bento cluster right (desktop lg+).
 * Mobile: single-column stack (text above bento cluster).
 *
 * bento_items[] contains exactly 2 entries:
 *   [0] type:"stat"    -- large metric card: stat value, progress bar, mini-stats, tags
 *   [1] type:"marquee" -- compact "trusted by" wordmark card below stat card
 *
 * Invariants:
 *   - No hardcoded hex -- all colors via var(--color-*) + fallback.
 *   - No opacity:0 in SSR output -- content fully visible without JS (Growth-69).
 *   - backdrop-filter blur on bento cards is progressive CSS enhancement only.
 *   - Marquee wordmarks rendered as static <span> list by default (no-JS visible).
 *     CSS animation applied via @media (prefers-reduced-motion: no-preference) guard.
 *   - Zero <img> tags in bento cluster (no photos, no icon library).
 *   - Stat card icon is a 2-letter monogram rendered in primary-subtle bg (inline SVG-free).
 *   - G-8: ASCII filename.
 */

// ---- Types ------------------------------------------------------------------

interface MiniStat {
  value: string
  label: string
}

interface BentoTag {
  label: string
  status?: "ok" | "warn" | "neutral"
}

interface BentoStatItem {
  type: "stat"
  icon_label: string
  primary_value: string
  primary_label: string
  progress_label: string
  progress_value: number     // 0-100 integer
  progress_max: number       // always 100
  mini_stats: MiniStat[]
  tags: BentoTag[]
}

interface BentoMarqueeItem {
  type: "marquee"
  eyebrow: string
  companies: string[]
}

type BentoItem = BentoStatItem | BentoMarqueeItem

interface StyleHints {
  bg?: string
  text_align?: string
  cta_style?: string
  cta_secondary_style?: string
  bento_layout?: string
  bento_stack_mobile?: boolean
  bento_card_blur?: string
  bento_show_marquee?: boolean
}

interface Props {
  copy: {
    badge?: string
    headline: string
    subhead: string
    supporting_text?: string
  }
  cta: { label: string; href: string }
  cta_secondary?: { label: string; href: string }
  bento_items: BentoItem[]
  variant?: string
  styleHints?: StyleHints
  motionPreset?: string
}

// ---- Props ------------------------------------------------------------------

const {
  copy = { headline: '', subhead: '' },
  cta,
  cta_secondary,
  bento_items = [],
  styleHints = {},
  motionPreset = 'fade-up',
} = Astro.props

// Extract stat card and marquee card from bento_items[]
const statCard = bento_items.find((it): it is BentoStatItem => it.type === 'stat')
const marqueeCard = bento_items.find((it): it is BentoMarqueeItem => it.type === 'marquee')

// CTA classes -- primary-lg and primary-outline (matching prism theme cta_style tokens)
const ctaClasses: Record<string, string> = {
  'primary-lg': [
    'inline-block px-6 py-3',
    'rounded-[var(--radius-button,6px)]',
    'bg-[var(--color-primary,#1B4FA8)]',
    'text-white font-semibold text-base',
    'hover:bg-[var(--color-primary-hover,#2260C4)]',
    'transition-colors',
  ].join(' '),
  'primary-outline': [
    'inline-block px-6 py-3',
    'rounded-[var(--radius-button,6px)]',
    'border border-[var(--color-primary,#1B4FA8)]',
    'text-[var(--color-primary,#1B4FA8)] font-semibold text-base',
    'hover:bg-[var(--color-primary-subtle,#EBF1FB)]',
    'transition-colors',
  ].join(' '),
}

const ctaStyle = styleHints.cta_style ?? 'primary-lg'
const ctaSecondaryStyle = styleHints.cta_secondary_style ?? 'primary-outline'

// Status dot color mapping (Growth-69: no JS, inline style only)
const statusColor: Record<string, string> = {
  ok: 'var(--color-bento-status-ok, #16A34A)',
  warn: 'var(--color-bento-status-warn, #CA8A04)',
  neutral: 'var(--color-text-3, #607394)',
}

// Monogram: first 2 chars of icon_label for the stat card icon badge
const iconMonogram = statCard
  ? statCard.icon_label.replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase()
  : 'PR'

// Progress bar width: clamp 0-100
const progressPct = statCard ? Math.min(100, Math.max(0, statCard.progress_value)) : 0
---

<section
  class="relative w-full py-[var(--space-section-y,88px)] px-[var(--space-container-gutter,24px)] bg-[var(--color-surface-1,#FFFFFF)]"
  data-motion={motionPreset}
  aria-label="Site introduction"
>
  <div class="max-w-[var(--space-container-max,1160px)] mx-auto w-full">

    {/* Desktop: 7/5 grid. Mobile: single column (text first, bento below). */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

      {/* ── Left column: 7 of 12 cols ── */}
      <div class="lg:col-span-7 flex flex-col justify-center">

        {/* Badge / eyebrow pill */}
        {copy.badge && (
          <div class="mb-6">
            <span
              class="inline-block text-xs font-semibold uppercase tracking-[0.12em] px-3 py-1.5"
              style={[
                'background: var(--color-primary-subtle, #EBF1FB);',
                'color: var(--color-primary, #1B4FA8);',
                'border-radius: var(--radius-badge, 9999px);',
                'border: 1px solid var(--color-primary-border, #5A83C8);',
              ].join(' ')}
            >
              {copy.badge}
            </span>
          </div>
        )}

        {/* Headline */}
        {copy.headline && (
          <h1
            class="text-4xl md:text-5xl lg:text-[length:var(--font-size-6xl,60px)] font-[var(--font-weight-display,700)] leading-[1.08] tracking-[var(--font-letter-spacing-display,-0.018em)] mb-6"
            style="font-family: var(--font-family-display, inherit); color: var(--color-text-1, #141C28);"
          >
            {copy.headline}
          </h1>
        )}

        {/* Subhead */}
        {copy.subhead && (
          <p
            class="text-lg md:text-xl mb-5 max-w-xl leading-relaxed"
            style="color: var(--color-text-2, #354769); font-family: var(--font-family-body, inherit);"
          >
            {copy.subhead}
          </p>
        )}

        {/* Supporting text (optional third line) */}
        {copy.supporting_text && (
          <p
            class="text-base mb-6"
            style="color: var(--color-text-3, #607394); font-family: var(--font-family-body, inherit);"
          >
            {copy.supporting_text}
          </p>
        )}

        {/* CTA row */}
        <div class="flex flex-wrap gap-3 mt-2">
          {cta && (
            <a
              href={cta.href}
              class={ctaClasses[ctaStyle] ?? ctaClasses['primary-lg']}
              style="font-family: var(--font-family-display, inherit);"
            >
              {cta.label}
            </a>
          )}
          {cta_secondary && (
            <a
              href={cta_secondary.href}
              class={ctaClasses[ctaSecondaryStyle] ?? ctaClasses['primary-outline']}
              style="font-family: var(--font-family-display, inherit);"
            >
              {cta_secondary.label}
            </a>
          )}
        </div>
      </div>

      {/* ── Right column: 5 of 12 cols -- bento cluster ── */}
      <div class="lg:col-span-5 flex flex-col gap-4">

        {/* ── Stat card ── */}
        {statCard && (
          <div
            class="rounded-[var(--radius-bento-card,12px)] p-5"
            style={[
              'background: var(--color-bento-card-bg, #F2F5FA);',
              'border: 1px solid var(--color-bento-card-border, #E2E8F2);',
              'box-shadow: var(--shadow-bento-card, 0 2px 16px -4px rgba(20,28,40,0.09), 0 1px 4px -1px rgba(20,28,40,0.05));',
              'backdrop-filter: blur(8px);',  /* progressive enhancement */
              '-webkit-backdrop-filter: blur(8px);',
            ].join(' ')}
          >
            {/* Icon badge row */}
            <div class="flex items-center gap-3 mb-4">
              {/* 2-letter monogram icon badge -- inline, no external icon library */}
              <div
                aria-hidden="true"
                style={[
                  'width: 40px; height: 40px;',
                  'border-radius: var(--radius-bento-card-inner, 8px);',
                  'background: var(--color-primary-subtle, #EBF1FB);',
                  'display: flex; align-items: center; justify-content: center;',
                  'flex-shrink: 0;',
                ].join(' ')}
              >
                <span
                  style={[
                    'font-family: var(--font-family-mono, monospace);',
                    'font-size: 13px; font-weight: 700; letter-spacing: 0.04em;',
                    'color: var(--color-primary, #1B4FA8);',
                  ].join(' ')}
                >
                  {iconMonogram}
                </span>
              </div>
              <span
                class="text-xs font-semibold uppercase tracking-[0.08em]"
                style="color: var(--color-text-3, #607394); font-family: var(--font-family-body, inherit);"
                aria-label={statCard.icon_label}
              >
                {statCard.icon_label}
              </span>
            </div>

            {/* Primary stat value */}
            <div class="mb-1">
              <span
                class="text-4xl md:text-5xl font-bold"
                style={[
                  'font-family: var(--font-family-mono, monospace);',
                  'color: var(--color-bento-stat-value, #141C28);',
                  'letter-spacing: var(--font-letter-spacing-mono, 0);',
                  'line-height: 1.1;',
                ].join(' ')}
              >
                {statCard.primary_value}
              </span>
            </div>
            <p
              class="text-sm mb-4"
              style="color: var(--color-text-2, #354769); font-family: var(--font-family-body, inherit);"
            >
              {statCard.primary_label}
            </p>

            {/* Progress bar */}
            <div class="mb-4">
              <div class="flex justify-between items-center mb-1.5">
                <span
                  class="text-xs"
                  style="color: var(--color-text-3, #607394); font-family: var(--font-family-body, inherit);"
                >
                  {statCard.progress_label}
                </span>
                <span
                  class="text-xs font-semibold"
                  style="color: var(--color-primary, #1B4FA8); font-family: var(--font-family-mono, monospace);"
                >
                  {statCard.progress_value}%
                </span>
              </div>
              {/* Progress track */}
              <div
                role="progressbar"
                aria-valuenow={statCard.progress_value}
                aria-valuemin={0}
                aria-valuemax={statCard.progress_max}
                aria-label={statCard.progress_label}
                style={[
                  'height: 6px;',
                  'border-radius: var(--radius-bento-card-inner, 8px);',
                  'background: var(--color-surface-3, #E2E8F2);',
                  'overflow: hidden;',
                ].join(' ')}
              >
                <div
                  style={[
                    `width: ${progressPct}%;`,
                    'height: 100%;',
                    'border-radius: var(--radius-bento-card-inner, 8px);',
                    'background: var(--color-primary, #1B4FA8);',
                  ].join(' ')}
                />
              </div>
            </div>

            {/* Mini-stats: 3-col grid */}
            {statCard.mini_stats && statCard.mini_stats.length > 0 && (
              <div
                style={[
                  `grid-template-columns: repeat(${statCard.mini_stats.length}, 1fr);`,
                  'display: grid; gap: 8px; margin-bottom: 14px;',
                ].join(' ')}
              >
                {statCard.mini_stats.map((ms) => (
                  <div
                    style={[
                      'padding: 8px 10px;',
                      'border-radius: var(--radius-bento-card-inner, 8px);',
                      'background: var(--color-surface-1, #FFFFFF);',
                      'border: 1px solid var(--color-bento-card-border, #E2E8F2);',
                      'text-align: center;',
                    ].join(' ')}
                  >
                    <div
                      style={[
                        'font-family: var(--font-family-mono, monospace);',
                        'font-size: 15px; font-weight: 600;',
                        'color: var(--color-bento-stat-value, #141C28);',
                        'line-height: 1.2;',
                      ].join(' ')}
                    >
                      {ms.value}
                    </div>
                    <div
                      style={[
                        'font-family: var(--font-family-body, inherit);',
                        'font-size: 10px; font-weight: 500;',
                        'color: var(--color-text-3, #607394);',
                        'margin-top: 2px;',
                        'text-transform: uppercase; letter-spacing: 0.06em;',
                      ].join(' ')}
                    >
                      {ms.label}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {/* Status tag pills */}
            {statCard.tags && statCard.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {statCard.tags.map((tag) => (
                  <span
                    style={[
                      'display: inline-flex; align-items: center; gap: 5px;',
                      'padding: 3px 8px;',
                      'border-radius: var(--radius-badge, 9999px);',
                      'background: var(--color-surface-1, #FFFFFF);',
                      'border: 1px solid var(--color-bento-card-border, #E2E8F2);',
                      'font-family: var(--font-family-body, inherit);',
                      'font-size: 11px; font-weight: 500;',
                      'color: var(--color-text-2, #354769);',
                    ].join(' ')}
                  >
                    {/* Status dot */}
                    <span
                      aria-hidden="true"
                      style={[
                        'width: 6px; height: 6px;',
                        'border-radius: 50%; flex-shrink: 0;',
                        `background: ${statusColor[tag.status ?? 'neutral']};`,
                      ].join(' ')}
                    />
                    {tag.label}
                  </span>
                ))}
              </div>
            )}
          </div>
        )}

        {/* ── Marquee card ── */}
        {marqueeCard && (
          <div
            class="rounded-[var(--radius-bento-card,12px)] p-4"
            style={[
              'background: var(--color-bento-card-bg, #F2F5FA);',
              'border: 1px solid var(--color-bento-card-border, #E2E8F2);',
              'box-shadow: var(--shadow-bento-card, 0 2px 16px -4px rgba(20,28,40,0.09), 0 1px 4px -1px rgba(20,28,40,0.05));',
              'backdrop-filter: blur(8px);',
              '-webkit-backdrop-filter: blur(8px);',
              'overflow: hidden;',
            ].join(' ')}
          >
            {/* Eyebrow label */}
            <p
              class="text-xs font-semibold uppercase tracking-[0.10em] mb-3"
              style="color: var(--color-text-3, #607394); font-family: var(--font-family-body, inherit);"
            >
              {marqueeCard.eyebrow}
            </p>

            {/*
              Wordmark row.
              Growth-69: ALL company names are in static DOM as <span> elements.
              No opacity:0 here. Animation (CSS marquee scroll) is added below
              via @media (prefers-reduced-motion: no-preference).
              JS-off: static flex-wrap row -- all names visible.
              JS-on + motion allowed: CSS keyframe scrolls the inner track.
            */}
            <div
              class="bento-marquee-outer"
              aria-label={`${marqueeCard.eyebrow}: ${marqueeCard.companies.join(', ')}`}
              style="overflow: hidden; position: relative;"
            >
              {/*
                Two copies of the track enable seamless loop.
                Both are in DOM (SSR-visible). CSS hides the second copy when
                animation is off (no-JS / reduced-motion).
              */}
              <div class="bento-marquee-track" aria-hidden="false">
                {marqueeCard.companies.map((name) => (
                  <span
                    class="bento-marquee-item"
                    style={[
                      'font-family: var(--font-family-display, inherit);',
                      'font-size: 12px; font-weight: 600;',
                      'color: var(--color-text-2, #354769);',
                      'opacity: 0.7;',
                      'white-space: nowrap;',
                    ].join(' ')}
                  >
                    {name}
                  </span>
                ))}
                {/* Duplicate for seamless CSS loop -- aria-hidden, SR reads first copy */}
                {marqueeCard.companies.map((name) => (
                  <span
                    class="bento-marquee-item"
                    aria-hidden="true"
                    style={[
                      'font-family: var(--font-family-display, inherit);',
                      'font-size: 12px; font-weight: 600;',
                      'color: var(--color-text-2, #354769);',
                      'opacity: 0.7;',
                      'white-space: nowrap;',
                    ].join(' ')}
                  >
                    {name}
                  </span>
                ))}
              </div>
            </div>

            {/* Demo notice -- required per policy (fictional data declared) */}
            <p
              class="mt-3 text-[10px]"
              style="color: var(--color-text-3, #607394); font-family: var(--font-family-body, inherit);"
            >
              Simulated demo data &mdash; not real customer metrics
            </p>
          </div>
        )}

      </div>{/* end right column */}
    </div>{/* end grid */}
  </div>{/* end container */}
</section>

<style>
/*
 * Bento marquee: CSS-only scroll animation.
 * Static fallback: flex-wrap, all names visible in a wrapping row.
 * Animation enabled only when prefers-reduced-motion: no-preference (WCAG 2.3.3).
 * No JS required for ANY state -- Growth-69 invariant.
 */

.bento-marquee-track {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding: 2px 0;
}

.bento-marquee-item {
  display: inline-block;
}

/* Animated marquee: only when browser/user allows motion */
@media (prefers-reduced-motion: no-preference) {
  .bento-marquee-outer {
    /* Mask edges for fade-in/out effect on scroll edges */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .bento-marquee-track {
    flex-wrap: nowrap;
    width: max-content;
    animation: bento-scroll 22s linear infinite;
  }

  .bento-marquee-track:hover {
    animation-play-state: paused;
  }
}

@keyframes bento-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
</style>
