---
/**
 * Pricing.astro — Pricing Table section (type: pricing).
 * Variants: two-tier | three-tier | toggle-annual-monthly
 * Style hints: highlight_tier (0-based int or "none"), card_style, show_toggle
 * DEC-3: highlight_tier is 0-based card index.
 */
interface PricingTier {
  name: string
  price: string
  period?: string
  features: string[]
  cta_label?: string
  cta_href?: string
}

interface StyleHints {
  highlight_tier?: number | string
  card_style?: string
  show_toggle?: boolean
}

interface Props {
  copy: Record<string, string>
  variant?: string
  styleHints?: StyleHints
  motionPreset?: string
  tiers?: PricingTier[]
}

const {
  copy = {},
  variant = 'three-tier',
  styleHints = {},
  motionPreset = 'reveal-on-scroll',
  tiers = [],
} = Astro.props

// DEC-3: highlight_tier is 0-based index into the tiers array (copy order).
const rawHighlight = styleHints.highlight_tier
const highlightIndex: number | null =
  rawHighlight === 'none' || rawHighlight === undefined || rawHighlight === null
    ? null
    : Number(rawHighlight)

const cardStyle = styleHints.card_style ?? 'elevated'

const cardBase: Record<string, string> = {
  elevated: 'rounded-[var(--radius-card,16px)] shadow-[var(--shadow-card)] bg-white p-8',
  bordered: 'rounded-[var(--radius-card,16px)] border border-[var(--color-border,#E5E7EB)] bg-white p-8',
  flat: 'p-8',
  ghost: 'p-8',
}

// Demo tiers
const tierCount = variant === 'two-tier' ? 2 : 3
const displayTiers: PricingTier[] = tiers.length > 0 ? tiers : Array.from({ length: tierCount }, (_, i) => ({
  name: i === 0 ? 'Starter' : i === 1 ? 'Growth' : 'Enterprise',
  price: i === 0 ? '$29' : i === 1 ? '$79' : '$199',
  period: '/mo',
  features: [
    `${(i + 1) * 3} projects`,
    `${(i + 1) * 10}GB storage`,
    i >= 1 ? 'Priority support' : 'Email support',
    i >= 2 ? 'Custom integrations' : '',
  ].filter(Boolean),
  cta_label: i < 2 ? 'Get started' : 'Contact sales',
  cta_href: '/contact',
}))
---

<section
  class="w-full py-[var(--space-section-y,112px)] px-[var(--space-container-gutter,24px)] bg-[var(--color-section-alt-bg,var(--color-surface-2,#F9FAFB))]"
  data-motion={motionPreset}
>
  <div class="max-w-[var(--space-container-max,1200px)] mx-auto">
    {copy.headline && (
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text-1,#111827)] mb-4" style="font-family: var(--font-family-display, inherit);">
          {copy.headline}
        </h2>
        {copy.subhead && (
          <p class="text-lg text-[var(--color-text-2,#374151)] max-w-2xl mx-auto">
            {copy.subhead}
          </p>
        )}
      </div>
    )}

    <div class={`grid grid-cols-1 gap-8 ${displayTiers.length === 2 ? 'md:grid-cols-2 max-w-3xl mx-auto' : 'md:grid-cols-3'}`}>
      {displayTiers.map((tier, i) => {
        const isHighlighted = highlightIndex !== null && i === highlightIndex
        return (
          <div
            class={`${cardBase[cardStyle] ?? cardBase.elevated} flex flex-col relative ${
              isHighlighted
                ? 'ring-2 ring-[var(--color-primary,#6D28D9)] scale-105 z-10'
                : ''
            }`}
          >
            {isHighlighted && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-[var(--color-primary,#6D28D9)] text-white text-xs font-bold px-3 py-1 rounded-[var(--radius-badge,9999px)] whitespace-nowrap">
                Most Popular
              </div>
            )}
            <div class="mb-6">
              <h3 class="text-xl font-bold text-[var(--color-text-1,#111827)] mb-2">{tier.name}</h3>
              <div class="flex items-baseline gap-1">
                <span class="text-4xl font-extrabold text-[var(--color-text-1,#111827)]">{tier.price}</span>
                {tier.period && <span class="text-[var(--color-text-3,#6B7280)]">{tier.period}</span>}
              </div>
            </div>
            <ul class="flex-1 space-y-3 mb-8">
              {tier.features.map((feat) => (
                <li class="flex items-center gap-2 text-[var(--color-text-2,#374151)]">
                  <svg class="w-4 h-4 flex-shrink-0 text-[var(--color-primary,#6D28D9)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feat}
                </li>
              ))}
            </ul>
            {tier.cta_label && (
              <a
                href={tier.cta_href ?? '/contact'}
                class={`block text-center px-6 py-3 rounded-[var(--radius-button,8px)] font-semibold transition-colors ${
                  isHighlighted
                    ? 'bg-[var(--color-primary,#6D28D9)] text-white hover:bg-[var(--color-primary-hover,#5B21B6)]'
                    : 'border border-[var(--color-primary,#6D28D9)] text-[var(--color-primary,#6D28D9)] hover:bg-[var(--color-primary-subtle,#F5F3FF)]'
                }`}
              >
                {tier.cta_label}
              </a>
            )}
          </div>
        )
      })}
    </div>

    {copy.disclaimer && (
      <p class="text-center text-sm text-[var(--color-text-3,#6B7280)] mt-8">{copy.disclaimer}</p>
    )}
  </div>
</section>
