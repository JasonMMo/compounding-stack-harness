---
/**
 * Stats.astro — Stats / Metrics Band section (type: stats).
 * Variants: ticker-band | four-up
 *
 * ticker-band: full-width band, stats inline separated by thin left-border.
 *   No card boxing. Large display-font numerals.
 *   Pure Astro — no React island. No JS required. Growth-69 invariant.
 *
 *   BG mode is driven by styleHints.bg (from theme sections.stats.ticker-band.bg):
 *     dark / hero-bg / unset → dark charcoal band (var(--color-hero-bg-from)).
 *       Value color = var(--color-primary-border) (amber/gold on dark — original flux behaviour).
 *       Label color = var(--color-surface-3). Separator = surface-3.
 *     light / surface-1 / surface-2 / surface-3 → light band.
 *       Background = var(--color-surface-2). Value color = var(--color-primary)
 *       (7:1 AAA on surface-2 for prism #1B4FA8 on #F2F5FA). Label = var(--color-text-2).
 *       Separator = var(--color-border, --color-surface-3).
 *   This honours CDO specs across themes without hardcoding any hex.
 *   flux theme sets bg:dark → dark band (no regression). prism sets bg:surface-2 → light band.
 *
 * four-up: 4 stats in a grid row; large number + small label per cell.
 *   Fallback variant — uses primary bg (theme-defined per sections.stats.four-up).
 *
 * All colors via theme tokens. No hardcoded hex (fallback values only).
 * Motion: data-motion attribute for IntersectionObserver entrance.
 */

interface StatItem {
  value: string
  label: string
}

interface StyleHints {
  bg?: string
  text_align?: string
  separator_style?: string
  layout?: string
}

interface Props {
  copy?: Record<string, string>
  variant?: string
  styleHints?: StyleHints
  motionPreset?: string
  items?: StatItem[]
}

const {
  copy = {},
  variant = 'ticker-band',
  styleHints = {},
  motionPreset = 'scale-in',
  items = [],
} = Astro.props

// Default demo stats if no items provided
const displayItems: StatItem[] = items.length > 0 ? items : [
  { value: '99.99%', label: 'Uptime SLA' },
  { value: '2.1B', label: 'Events / day' },
  { value: '<50ms', label: 'P99 latency' },
  { value: '10k+', label: 'Teams' },
]

// BG mode resolution for ticker-band.
// Light surface keys: surface-1, surface-2, surface-3, light.
// Everything else (dark, hero-bg, unset) → dark band (backward-compat with flux).
const LIGHT_BG_KEYS = new Set(['surface-1', 'surface-2', 'surface-3', 'light'])
const tickerBg = styleHints.bg ?? ''
const tickerIsLight = LIGHT_BG_KEYS.has(tickerBg)
---

{variant === 'ticker-band' ? (
  <section
    class="w-full py-[var(--space-section-y-mobile,64px)] px-[var(--space-container-gutter,24px)]"
    style={tickerIsLight
      ? 'background: var(--color-surface-2, #F2F5FA);'
      : 'background: var(--color-hero-bg-from, #1A1610);'}
    aria-label={copy.headline ?? 'Platform statistics'}
    data-motion={motionPreset}
  >
    <div class="max-w-[var(--space-container-max,1180px)] mx-auto">
      {copy.headline && (
        <p
          class="text-center text-sm font-medium uppercase tracking-[0.1em] mb-8"
          style={tickerIsLight
            ? 'color: var(--color-text-2, #354769); font-family: var(--font-family-body, inherit);'
            : 'color: var(--color-surface-3, #DDDBD7); font-family: var(--font-family-body, inherit);'}
        >
          {copy.headline}
        </p>
      )}
      {/*
        Mobile (<640px): 2-column grid — each stat gets full cell width, no overflow.
        sm+ (>=640px): flex row with dividers between items.
        border-left dividers applied only on sm+ via a CSS class to avoid
        misaligned dividers on wrapped rows.
        Separator color: light mode = var(--color-border, surface-3); dark = surface-3.
      */}
      <ul
        class="grid grid-cols-2 sm:flex sm:flex-row sm:flex-wrap sm:items-center sm:justify-center list-none m-0 p-0 gap-y-8 sm:gap-y-0"
        role="list"
      >
        {displayItems.map((stat, i) => (
          <li
            class={`flex flex-col items-center text-center py-2 sm:py-4 px-4 sm:px-[clamp(20px,3vw,48px)]`}
            style={i > 0
              ? (tickerIsLight
                  ? 'border-left: 1px solid var(--color-border, var(--color-surface-3, #E2E8F2));'
                  : 'border-left: 1px solid var(--color-surface-3, #DDDBD7);')
              : ''}
          >
            <span
              class="leading-none font-[var(--font-weight-display,700)]"
              style={tickerIsLight
                ? 'font-family: var(--font-family-display, inherit); font-size: clamp(2rem, 5vw, 3.5rem); color: var(--color-primary, #1B4FA8);'
                : 'font-family: var(--font-family-display, inherit); font-size: clamp(2rem, 5vw, 3.5rem); color: var(--color-primary-border, #C99430);'}
            >
              {stat.value}
            </span>
            <span
              class="mt-2 text-xs font-medium uppercase tracking-[0.1em]"
              style={tickerIsLight
                ? 'color: var(--color-text-2, #354769); font-family: var(--font-family-body, inherit);'
                : 'color: var(--color-surface-3, #DDDBD7); font-family: var(--font-family-body, inherit);'}
            >
              {stat.label}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
) : (
  /*
   * four-up: full-bleed crimson band (bg: primary). White numerals on crimson.
   * ignite theme spec: 4 stats in a row, large Barlow Condensed 800 numeral,
   * uppercase label at 78% opacity. Grid-4 desktop, 2×2 mobile. No card boxing.
   * Vertical separator: 1px rgba(250,250,248,0.20) between columns on desktop.
   * Passes WCAG AA: white (#FAFAF8) on violet (#6D28D9) = 7.0:1.
   */
  <section
    class="w-full stats-four-up"
    aria-label={copy.headline ?? 'Event statistics'}
    data-motion={motionPreset}
    style="background:var(--color-primary,#6D28D9);padding:var(--space-section-y,88px) var(--space-container-gutter,20px);"
  >
    <div style="max-width:var(--space-container-max,1120px);margin:0 auto;">
      {copy.headline && (
        <h2
          class="text-center mb-12"
          style="font-family:var(--font-family-display,inherit);font-size:var(--font-size-5xl,48px);font-weight:var(--font-weight-display,800);color:var(--color-surface-1,#FAFAF8);"
        >
          {copy.headline}
        </h2>
      )}
      <ul
        class="stats-four-up-grid list-none m-0 p-0"
        role="list"
      >
        {displayItems.map((stat, i) => (
          <li
            class={`flex flex-col items-center text-center stats-four-up-cell${i > 0 ? ' stats-four-up-sep' : ''}`}
            style="padding:0 24px;"
          >
            <span
              style="font-family:var(--font-family-display,inherit);font-size:64px;font-weight:800;line-height:1.0;color:var(--color-surface-1,#FAFAF8);"
            >
              {stat.value}
            </span>
            <span
              style="font-family:var(--font-family-body,inherit);font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:rgba(250,250,248,0.78);margin-top:8px;"
            >
              {stat.label}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
