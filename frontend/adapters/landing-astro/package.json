    "@fontsource-variable/cormorant-garamond": "^5.2.6",
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/epilogue": "^5.2.8",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/karla": "^5.2.8",
    "@fontsource-variable/raleway": "^5.2.8",
