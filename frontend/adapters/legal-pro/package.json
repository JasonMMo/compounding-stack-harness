{
  "name": "legal-pro-react-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "React 18 + Vite + TypeScript SPA — legal-pro vertical adapter (법무법인 판례 검색 UI)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "codegen": "node scripts/codegen.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "prebuild": "npm run codegen && npm run build:tokens",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
