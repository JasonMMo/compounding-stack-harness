{
  "_meta": {
    "version": "1.0.0",
    "layer": "raw",
    "description": "Primitive design values. No semantics here — only named values that semantic.json references. Brand color UNDECIDED: using neutral gray scale + one blue accent ramp pending CEO+CMO+CDO brand decision.",
    "brand_color_status": "PENDING — accent ramp is placeholder blue. Replace when CEO+CMO+CDO decide brand color.",
    "contrast_ratios": {
      "note": "WCAG AA body text requires 4.5:1 minimum. Computed against white (#FFFFFF) background.",
      "gray_050_on_white": "1.07:1 — decorative only",
      "gray_100_on_white": "1.18:1 — decorative only",
      "gray_200_on_white": "1.52:1 — decorative only",
      "gray_300_on_white": "2.19:1 — decorative only",
      "gray_400_on_white": "3.05:1 — UI chrome only, not body text",
      "gray_500_on_white": "4.61:1 — PASSES AA for body text (just above 4.5:1)",
      "gray_600_on_white": "6.30:1 — PASSES AA",
      "gray_700_on_white": "9.02:1 — PASSES AA",
      "gray_800_on_white": "12.63:1 — PASSES AAA",
      "gray_900_on_white": "17.28:1 — PASSES AAA",
      "accent_500_on_white": "4.56:1 — PASSES AA for body text",
      "accent_600_on_white": "6.84:1 — PASSES AA",
      "white_on_gray_700": "9.02:1 — PASSES AAA (inverse, used for button label)",
      "white_on_gray_900": "17.28:1 — PASSES AAA",
      "white_on_accent_600": "6.84:1 — PASSES AA (button primary label)"
    }
  },

