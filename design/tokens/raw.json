  "type": {
    "family": {
      "sans": "'Pretendard Variable', 'Pretendard', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans KR', 'Apple SD Gothic Neo', sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'Consolas', 'D2Coding', monospace"
    },
    "scale": {
      "xs":   { "size": "11px", "line_height": "16px" },
      "sm":   { "size": "12px", "line_height": "18px" },
      "md":   { "size": "14px", "line_height": "20px" },
      "lg":   { "size": "16px", "line_height": "24px" },
      "xl":   { "size": "18px", "line_height": "28px" },
      "2xl":  { "size": "20px", "line_height": "28px" },
      "3xl":  { "size": "24px", "line_height": "32px" },
      "4xl":  { "size": "30px", "line_height": "36px" },
      "display": { "size": "44px", "line_height": "52px" }
    },
    "weight": {
      "regular": "400",
      "medium":  "500",
      "semibold": "600",
      "bold":    "700"
    }
  },

  "space": {
    "0":  "0px",
    "1":  "2px",
    "2":  "4px",
    "3":  "6px",
    "4":  "8px",
    "5":  "10px",
    "6":  "12px",
    "8":  "16px",
    "10": "20px",
    "12": "24px",
    "16": "32px",
    "20": "40px",
    "24": "48px",
    "32": "64px",
    "40": "80px",
    "48": "96px"
