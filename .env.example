# .env.example — copy to .env and fill in values
# .env is gitignored; never commit actual credentials.

# PostgreSQL DSN for demo/test environments
# Special chars in password must be URL-encoded: ! → %21, @ → %40
# Or use keyword format in psycopg2 (setup_lawfirm.py uses DSN URL, so encode special chars).
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_SECURE_PASSWORD@localhost/lawfirm_db

# FastAPI port (default 8081; L4 tests use 8000)
# PORT=8081

# docker-compose.yml 전용 (postgres 컨테이너 초기화 값).
# 기존 호스트 postgres 를 쓰는 경우 무시된다.
# POSTGRES_USER=YOUR_DB_USER
# POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
# POSTGRES_DB=lawfirm_db
# POSTGRES_HOST_PORT=5432   # 호스트 5432 점유 시 5433 등으로 변경
