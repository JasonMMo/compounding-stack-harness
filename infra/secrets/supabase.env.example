# Supabase backend adapter — L4 live activation env template.
#
# USAGE (founder, one-time after provisioning a Supabase project):
#   1. Copy to a real (gitignored) env file:  cp supabase.env.example supabase.env
#   2. Fill both values from the Supabase dashboard:
#        Project Settings > API > Project URL          -> SUPABASE_URL
#        Project Settings > API > service_role secret  -> SUPABASE_SERVICE_ROLE_KEY
#   3. Load before running the adapter (see backend/adapters/supabase/README.md
#      "L4 Live Activation").
#
# SECURITY
#   - service_role bypasses Row Level Security — server-side ONLY, never ship to a client.
#   - The real supabase.env is gitignored (infra/secrets/* vault); only this .example is tracked.
#   - SUPABASE_ANON_KEY is intentionally NOT used by this adapter (server-side design).

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
