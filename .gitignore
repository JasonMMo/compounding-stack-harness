# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Java / Maven / Gradle
target/
build/
*.class
.gradle/
# NOTE: gradle-wrapper.jar는 의도적으로 추적한다 (gitignore 안 함).
# self-host harness 가치 제안 = "dev 환경 없이 빌드". gradle 미설치 고객사가
# ./gradlew 만으로 adapter 를 빌드하려면 wrapper jar 가 repo 에 있어야 함 (Gradle 공식 권장).

# Node
node_modules/
dist/
.next/
.nuxt/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Project artifacts
out/
docs/scaffolds/
docs/intake-inbox/ui-checks/
Videos/
*.local.yaml
*.local.json
.env
.env.local

# Cost / metrics tracking (local only)
metrics/local/
cost-reports/local/

# Digital-asset secret vault (DevOps, Growth-35) — 평문 시크릿 절대 커밋 금지.
# 레지스트리(infra/registry/*.yaml)엔 볼트 키 참조만, 평문 자격증명/토큰/키는 여기에만.
# README/*.example 만 추적(구조 문서화), 실제 시크릿 파일은 전부 무시.
infra/secrets/*
!infra/secrets/README.md
!infra/secrets/*.example

# Cloudflare Tunnel live config (contains real tunnel UUID — secret).
# Only config.example.yml is tracked; config.yml is local-only.
infra/cloudflared/config.yml

# Intake submissions (의뢰인 PII -- 로컬/서버 런타임 데이터, 절대 커밋 금지)
apps/intake/data/

# Intake PII mirror (intake_sync.py SSH rsync target -- raw PII, NEVER commit)
apps/intake/data-mirror/

# Test fixture mirror for intake_sync tests (use tmp dirs in tests instead)
apps/intake/data-test-fixture/

# CodeGraph index (local-first, tenant-scoped — rebuildable from source)
.codegraph/

# Ledger reverse-index (rebuildable from learn-log.md + docs/learn-logs/ via scripts/ledger-index.py)
docs/learn-logs/_index.json
docs/learn-logs/_index.md

# Local tooling artifact (observation/memory vault — not repo state)
.context/

# Serena MCP project cache (local LSP/symbol index — rebuildable, not repo state)
.serena/

# Claude Code session report exports (per-session HTML artifact — not repo state)
session-report-*.html

# Generated design-token CSS (build artifact — single source = design/tokens/*.json).
# build_tokens.py regenerates it; tracking it would risk drift from the JSON source.
# (Contrast: gradle-wrapper.jar above is tracked because it is NOT derivable from repo source.)
frontend/adapters/*/static/css/tokens.css

# Generated DDL (build artifact — single source = presets/ddl/catalog.yaml + dialects/).
# render.py regenerates per-dialect SQL; tracking it would risk drift from the catalog.
presets/ddl/build/

# L2 test harness artifacts (compiled classes, HSQLDB jar, build output)
tests/ddl/out/
tests/ddl/lib/
.obsidian/
_obsidian_attachments/
.gstack/
